# StormCheck Pro Environment Variables
# Copy this to .env and fill in your values

# JWT secret — make this a long random string
JWT_SECRET=change-this-to-a-long-random-secret-string-at-least-32-chars

# Stripe keys (get from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...   # fallback price if a plan-specific one is missing

# Admin account (set on first run)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password

# App settings
PORT=3000
BASE_URL=https://stormcheckpro.thepublicadjustertx.com
APP_NAME=StormCheck Pro

# NOAA API key (optional — free at ncdc.noaa.gov/cdo-web/token)
NOAA_CDO_API_KEY=

# Per-plan Stripe prices (monthly subscriptions)
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_TEAM=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...

# Meteorologist reviewed report (one-time price). Leave blank to take requests
# without payment; you'll get an email and can quote manually.
STRIPE_PRICE_ID_REVIEW=
REVIEW_PRICE=150

# Email (alerts, password resets, free alert digests, review notifications)
# Recommended on Railway: Resend (HTTPS API; Railway blocks outbound SMTP on most plans)
RESEND_API_KEY=
EMAIL_FROM=StormCheck Pro <alerts@thepublicadjustertx.com>
# Or SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StormCheck Pro <alerts@yourdomain.com>

# Radar / storm data pipeline
# DATA_JOBS=off                    # disable background data jobs (local dev)
MESH_BACKFILL_FROM=2020-10-15      # oldest radar day to load (2014-10-01 possible via Iowa State archive)
NCEI_FROM_YEAR=1996                # oldest NWS Storm Events year to load
# DATA_DIR=/data                   # defaults to the Railway volume, else ./data

# Sample report location shown at /sample-report
SAMPLE_LAT=32.9343
SAMPLE_LON=-97.0781
SAMPLE_LABEL=Grapevine, TX (city center)

# CRM integrations (JobNimbus, AccuLynx, webhooks). Customer API keys are
# encrypted with this secret (falls back to JWT_SECRET). Changing it means
# customers must reconnect.
# INTEGRATION_SECRET=
# INTEGRATIONS_SYNC=off            # pause scheduled CRM syncs

# In-app help assistant (bottom-right chat). Without a key it answers from the
# built-in guide by keyword search. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-5-5

# Ad tracking (each tag stays off until its ID is set). Sign-ups record the
# visitor's utm_source / utm_campaign / utm_content in the users CSV.
# META_PIXEL_ID=                     # Facebook / Instagram pixel (numbers only)
# GA4_MEASUREMENT_ID=                # G-XXXXXXX
# GOOGLE_ADS_ID=                     # AW-XXXXXXX
# GOOGLE_ADS_SIGNUP_LABEL=
# GOOGLE_ADS_PURCHASE_LABEL=
# LINKEDIN_PARTNER_ID=
# LINKEDIN_SIGNUP_CONVERSION_ID=
# LINKEDIN_PURCHASE_CONVERSION_ID=

# Storm recap emails (Admin → Storm Recaps). The postal address is required in
# every marketing email (CAN-SPAM); it can also be entered on the admin page.
# BUSINESS_ADDRESS=123 Main St, Southlake, TX 76092
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png   # base map for recap images

# Street View on reports. Enable the "Maps Embed API" in Google Cloud, create a
# key restricted to your domain (HTTP referrers). Without it, reports show an
# "Open Street View" button instead.
# GOOGLE_MAPS_EMBED_KEY=
# Server-side key used to find the nearest Street View photo and face it toward
# the house (Street View Static API enabled; metadata lookups are free). If not
# set, GOOGLE_MAPS_EMBED_KEY is tried. Restrict it by API, not by website.
# GOOGLE_MAPS_SERVER_KEY=

# Security. JWT_SECRET signs sign-ins: 64+ random characters (e.g. from
# `openssl rand -hex 48`). Without it the app generates one on the data volume.
# JWT_SECRET=
# NODE_ENV=production

# Encrypted nightly backups of accounts and settings (Admin → Security & Backups).
# Keep BACKUP_KEY in a password manager too: backups can't be restored without it.
# BACKUP_KEY=
# Off-server copies (any S3-compatible storage; Cloudflare R2 shown):
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=stormcheck-backups
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_REGION=auto

# Phone / browser hail alerts (Alerts → Phone Alerts). Keys are generated on the
# data volume automatically; set these only to use your own. Changing them means
# every device must turn alerts on again.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
