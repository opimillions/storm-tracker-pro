# StormCheck Pro Environment Variables
# Copy this to .env and fill in your values

# JWT secret — make this a long random string
JWT_SECRET=change-this-to-a-long-random-secret-string-at-least-32-chars

# Stripe keys (get from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...   # fallback price if a plan-specific one is missing

# Admin account (set on first run)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password

# App settings
PORT=3000
BASE_URL=https://stormcheckpro.thepublicadjustertx.com
APP_NAME=StormCheck Pro

# NOAA API key (optional — free at ncdc.noaa.gov/cdo-web/token)
NOAA_CDO_API_KEY=

# Per-plan Stripe prices (monthly subscriptions)
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_TEAM=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...

# Meteorologist reviewed report (one-time price). Leave blank to take requests
# without payment; you'll get an email and can quote manually.
STRIPE_PRICE_ID_REVIEW=
REVIEW_PRICE=150

# Email (alerts, password resets, free alert digests, review notifications)
# Recommended on Railway: Resend (HTTPS API; Railway blocks outbound SMTP on most plans)
RESEND_API_KEY=
EMAIL_FROM=StormCheck Pro <alerts@thepublicadjustertx.com>
# Or SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StormCheck Pro <alerts@yourdomain.com>

# Radar / storm data pipeline
# DATA_JOBS=off                    # disable background data jobs (local dev)
MESH_BACKFILL_FROM=2020-10-15      # oldest radar day to load (2014-10-01 possible via Iowa State archive)
NCEI_FROM_YEAR=1996                # oldest NWS Storm Events year to load
# DATA_DIR=/data                   # defaults to the Railway volume, else ./data

# Sample report location shown at /sample-report
SAMPLE_LAT=32.9343
SAMPLE_LON=-97.0781
SAMPLE_LABEL=Grapevine, TX (city center)

# CRM integrations (JobNimbus, AccuLynx, webhooks). Customer API keys are
# encrypted with this secret (falls back to JWT_SECRET). Changing it means
# customers must reconnect.
# INTEGRATION_SECRET=
# INTEGRATIONS_SYNC=off            # pause scheduled CRM syncs

# In-app help assistant (bottom-right chat). Without a key it answers from the
# built-in guide by keyword search. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-5-5
