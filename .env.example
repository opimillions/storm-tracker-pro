# StormCheck Pro Environment Variables
# Copy this to .env and fill in your values

# JWT secret — make this a long random string
JWT_SECRET=change-this-to-a-long-random-secret-string-at-least-32-chars

# Stripe keys (get from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...   # Your $99/mo subscription price ID

# Admin account (set on first run)
ADMIN_EMAIL=ryan@thepublicadjustertx.com
ADMIN_PASSWORD=change-this-password

# App settings
PORT=3000
BASE_URL=https://hailcheck.thepublicadjustertx.com
APP_NAME=StormCheck Pro

# NOAA API key (optional — free at ncdc.noaa.gov/cdo-web/token)
NOAA_CDO_API_KEY=
